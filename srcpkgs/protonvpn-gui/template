hostmakedepends="python3-setuptools"
depends="python3-proton-vpn-api-core python3-proton-core python3-gobject
 python3-cairo python3-dbus python3-packaging python3-distro python3-requests
 python3-proton-vpn-network-manager
 python3-proton-vpn-killswitch-network-manager python3-proton-keyring-linux
 python3-proton-vpn-local-agent gtk4 libnotify libayatana-appindicator"
short_desc="ProtonVPN Graphical User Interface"
