checksum=6d106a38befd51e045cfb8abdf4c5c8d249021038092d6a9cb1d81ad555f9ee6

post_install() {
	# Upstream ships these under rpmbuild/SOURCES (installed by the deb/rpm
	# packaging, not setup.py); install them so the app appears in DE menus.
	vinstall rpmbuild/SOURCES/proton.vpn.app.gtk.desktop 644 usr/share/applications
	vinstall rpmbuild/SOURCES/proton-vpn-logo.svg 644 \
		usr/share/icons/hicolor/scalable/apps
}
