do_extract() {
    git clone -b ${version} "https://github.com/mullvad/mullvadvpn-app.git" ./
    #git clone "git+https://github.com/mullvad/mullvadvpn-app-binaries.git#commit=${_commit}?signed"
    pushd gui
    npm install
    popd
#    echo welcome to bash
#    PS1="(debug) $$" bash
}

